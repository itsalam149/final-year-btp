# ==============================================================================
# GBNF Grammar for Privacy-First Offline AI Mobile Agent (JARVIS)
# Department of CSE, Delhi Technological University (DTU) | Group GP159
# 
# Purpose: Mathematically guarantees 100% valid JSON syntax from 4-bit / 8-bit
# quantized SLMs during on-device sampling, preventing the "4-bit syntax collapse".
# ==============================================================================

root ::= "{" ws "\"type\":" ws (action_payload | message_payload) ws "}"

# An action payload invokes a permitted mobile tool
action_payload ::= "\"action\"," ws "\"thought\":" ws string "," ws "\"tool\":" ws tool_name "," ws "\"parameters\":" ws tool_params

# A message payload delivers direct conversational response to the user
message_payload ::= "\"message\"," ws "\"thought\":" ws string "," ws "\"content\":" ws string

# Permitted 6 core mobile tools
tool_name ::= "\"create_reminder\"" | "\"search_calendar\"" | "\"manage_notes\"" | "\"search_local_docs\"" | "\"read_document_summary\"" | "\"draft_message\""

tool_params ::= reminder_params | calendar_params | notes_params | docs_params | summary_params | message_params

reminder_params ::= "{" ws "\"title\":" ws string "," ws "\"due_time_iso\":" ws string ("," ws "\"priority\":" ws ("\"low\"" | "\"normal\"" | "\"high\""))? ws "}"

calendar_params ::= "{" ws "\"date_iso\":" ws string ("," ws "\"query\":" ws string)? ws "}"

notes_params ::= "{" ws "\"action\":" ws ("\"create\"" | "\"read\"" | "\"list\"" | "\"search\"") ("," ws "\"title\":" ws string)? ("," ws "\"content\":" ws string)? ("," ws "\"query\":" ws string)? ws "}"

docs_params ::= "{" ws "\"query\":" ws string ("," ws "\"max_results\":" ws [0-9]+)? ws "}"

summary_params ::= "{" ws "\"filename\":" ws string ("," ws "\"focus_topic\":" ws string)? ws "}"

message_params ::= "{" ws "\"recipient\":" ws string "," ws "\"message_body\":" ws string ("," ws "\"platform\":" ws ("\"sms\"" | "\"whatsapp\""))? ws "}"

# JSON Primitives & Whitespace
string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
ws ::= [ \t\n\r]*
